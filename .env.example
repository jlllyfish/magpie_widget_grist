# --- Obligatoire ---

# Cle secrete Flask (signature des sessions/cookies).
# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# --- Bootstrap du premier compte admin ---
# Utilises UNE SEULE FOIS au tout premier demarrage, si la table users est vide.
# Vous pouvez les retirer du .env une fois le premier admin cree.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Base de donnees ---
# Chemin du fichier SQLite. Sur Railway, pointez vers le volume monte,
# par exemple /data/app.db pour qu'il survive aux redeploiements.
DATABASE_PATH=app.db

# --- Optionnel ---

# URL de l'instance Grist (preremplie dans le formulaire, modifiable par l'utilisateur)
GRIST_URL=https://grist.example.com

# Passer a "production" une fois derriere HTTPS pour forcer le cookie Secure
FLASK_ENV=development

# FLASK_DEBUG=1
