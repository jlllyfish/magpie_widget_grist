# Cle secrete Flask (signature du cookie de session, qui ne porte que le jeton CSRF).
# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# Instance Grist proposee par defaut dans le formulaire
GRIST_URL=https://grist.numerique.gouv.fr

# Instances Grist autorisees (noms d'hote exacts, separes par des virgules).
# Par defaut : l'hote de GRIST_URL. Toute autre instance est refusee (anti-SSRF).
ALLOWED_GRIST_HOSTS=grist.numerique.gouv.fr

# Domaines autorises a embarquer Magpie en iframe (CSP frame-ancestors)
ALLOWED_FRAME_ANCESTORS=https://grist.numerique.gouv.fr

# Fichier SQLite (sur Railway : le volume monte, ex. /data/app.db)
DATABASE_PATH=app.db
